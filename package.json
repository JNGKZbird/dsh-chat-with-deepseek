{
  "name": "dsh-chat-with-deepseek",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "description": "DSH Chat with DeepSeek：DeepSeek 网页聊天复刻插件，只保留联网搜索。",
  "license": "MIT",
  "author": "JNGKZbird",
  "repository": {
    "type": "git",
    "url": "https://github.com/JNGKZbird/dsh-chat-with-deepseek.git"
  },
  "homepage": "https://github.com/JNGKZbird/dsh-chat-with-deepseek",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./app/assets/*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "app",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "chat"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
